# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
build/
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Env
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database
*.db
*.db-journal
*.sqlite

# Electron
release/
*.dmg
*.exe
*.AppImage

# QVAC models cache (downloaded P2P, never committed)
.qvac/
**/resources/models/
*.gguf
*.onnx
*.bin

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Test coverage
coverage/

# Wallet vault — should never end up here, but defense in depth.
# (Real path is app.getPath('userData')/wallet.vault — OS-specific.)
**/wallet.vault
**/*.vault

# Local archive backups
*.tar.gz
*.zip

# Generated investigation PDFs (users export these from the app)
INV-*.pdf
investigation-*.pdf
