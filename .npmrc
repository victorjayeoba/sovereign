# Hoist electron + native modules to root so their postinstall scripts run
# and so electron-vite can find the Electron binary via Node module resolution.
# Everything else stays isolated (default pnpm behavior).
public-hoist-pattern[]=electron
public-hoist-pattern[]=electron-vite
public-hoist-pattern[]=*types*
auto-install-peers=true
strict-peer-dependencies=false
