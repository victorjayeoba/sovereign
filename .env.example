# Sovereign environment variables (copy to .env and fill in)

# ── Solana ─────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Mock USDT-SPL mint deployed on devnet (real USDT-SPL is mainnet-only).
# Fill this in after running scripts/deploy-mock-usdt.ts
USDT_MINT_DEVNET=

# ── Sentinel API ───────────────────────────────────────────
# Sovereign runs Sentinel locally — start it with:
#   pnpm --filter sentinel dev
# Override only if you've deployed Sentinel publicly.
SENTINEL_URL=http://localhost:8787

# Per-lookup price in USDT base units (6 decimals → 10000 = 0.01 USDT)
LOOKUP_PRICE=10000

# ── Sentinel-side secrets (set via wrangler secret put) ─────
# TREASURY_PRIVATE_KEY=
# ADMIN_BEARER=
# TREASURY_ATA=
